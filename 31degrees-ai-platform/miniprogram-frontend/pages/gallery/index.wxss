/* pages/gallery/index.wxss */

.container {
  min-height: 100vh;
  background-color: #f8fafc;
  padding-bottom: 120rpx; /* 为tabBar留出空间 */
}

/* 顶部搜索栏 */
.header {
  display: flex;
  align-items: center;
  padding: 20rpx 40rpx;
  background: #ffffff;
  border-bottom: 2rpx solid #f1f5f9;
}

.search-bar {
  flex: 1;
  display: flex;
  align-items: center;
  background-color: #f8fafc;
  border-radius: 50rpx;
  padding: 16rpx 24rpx;
  margin-right: 20rpx;
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 16rpx;
  opacity: 0.6;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #1f2937;
}

.filter-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f8fafc;
  border-radius: 50%;
}

.filter-icon {
  width: 40rpx;
  height: 40rpx;
  opacity: 0.7;
}

/* 筛选标签 */
.filter-tags {
  padding: 20rpx 0;
  background: #ffffff;
  border-bottom: 2rpx solid #f1f5f9;
}

.tags-list {
  display: inline-flex;
  padding: 0 40rpx;
}

.tag-item {
  padding: 12rpx 24rpx;
  background: #f8fafc;
  border-radius: 50rpx;
  margin-right: 16rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.tag-item.active {
  background: #ede9fe;
  border-color: #6366f1;
}

.tag-text {
  font-size: 26rpx;
  color: #6b7280;
}

.tag-item.active .tag-text {
  color: #6366f1;
  font-weight: 500;
}

/* 作品网格 */
.gallery-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  padding: 40rpx;
}

.artwork-item {
  position: relative;
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
  transition: all 0.3s ease;
}

.artwork-item:active {
  transform: scale(0.98);
}

.artwork-image {
  width: 100%;
  height: 300rpx;
  background-color: #f8fafc;
}

.artwork-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.7));
  padding: 40rpx 20rpx 20rpx;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.artwork-item:hover .artwork-overlay {
  opacity: 1;
}

.artwork-info {
  margin-bottom: 16rpx;
}

.artwork-prompt {
  display: block;
  font-size: 24rpx;
  color: #ffffff;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.artwork-time {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.8);
}

.artwork-actions {
  display: flex;
  justify-content: space-around;
}

.action-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  backdrop-filter: blur(10rpx);
}

.action-icon {
  width: 28rpx;
  height: 28rpx;
}

.artwork-type {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  background: rgba(0, 0, 0, 0.6);
  color: #ffffff;
  padding: 8rpx 12rpx;
  border-radius: 12rpx;
  backdrop-filter: blur(10rpx);
}

.type-text {
  font-size: 20rpx;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  opacity: 0.6;
  margin-bottom: 40rpx;
}

.empty-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #374151;
  margin-bottom: 16rpx;
}

.empty-desc {
  display: block;
  font-size: 28rpx;
  color: #6b7280;
  margin-bottom: 60rpx;
  line-height: 1.5;
}

.create-btn {
  background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
  color: #ffffff;
  border-radius: 50rpx;
  padding: 24rpx 48rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
}

.create-btn::after {
  border: none;
}

/* 加载更多 */
.load-more {
  padding: 40rpx;
  text-align: center;
}

.load-more-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 40rpx;
  background: #ffffff;
  border-radius: 50rpx;
  color: #6366f1;
  font-size: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.loading-spinner {
  display: flex;
  align-items: center;
}

.spinner-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
}

/* 筛选弹窗 */
.filter-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1000;
}

.modal-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  background: #ffffff;
  border-radius: 40rpx 40rpx 0 0;
  max-height: 80vh;
  overflow: hidden;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx;
  border-bottom: 2rpx solid #f1f5f9;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1f2937;
}

.modal-close {
  font-size: 60rpx;
  color: #9ca3af;
  line-height: 1;
}

.modal-body {
  padding: 40rpx;
  max-height: 60vh;
  overflow-y: auto;
}

.filter-group {
  margin-bottom: 40rpx;
}

.filter-label {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #1f2937;
  margin-bottom: 20rpx;
}

.filter-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.filter-option {
  padding: 16rpx 24rpx;
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  border-radius: 50rpx;
  font-size: 26rpx;
  color: #6b7280;
  transition: all 0.3s ease;
}

.filter-option.active {
  background: #ede9fe;
  border-color: #6366f1;
  color: #6366f1;
}

.modal-footer {
  display: flex;
  padding: 40rpx;
  gap: 20rpx;
  background: #f8fafc;
}

.reset-btn, .apply-btn {
  flex: 1;
  padding: 24rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  border: none;
}

.reset-btn {
  background: #ffffff;
  color: #6b7280;
  border: 2rpx solid #e2e8f0;
}

.reset-btn::after {
  border: none;
}

.apply-btn {
  background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
  color: #ffffff;
}

.apply-btn::after {
  border: none;
}

/* 加载状态 */
.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.loading-content {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.loading-icon {
  width: 60rpx;
  height: 60rpx;
  margin-bottom: 24rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #6b7280;
}

.spin {
  animation: spin 1s linear infinite;
}

@keyframes spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

/* 响应式适配 */
@media screen and (max-width: 750rpx) {
  .gallery-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 16rpx;
    padding: 20rpx;
  }
  
  .artwork-image {
    height: 250rpx;
  }
}