/* pages/index/index.wxss */

.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding-bottom: 120rpx; /* 为底部tabBar留出空间 */
}

/* 头部区域 */
.header {
  padding: 60rpx 40rpx 40rpx;
  color: #ffffff;
}

.welcome-section {
  text-align: center;
  margin-bottom: 40rpx;
}

.welcome-title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
  color: #ffffff;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}

.welcome-subtitle {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 用户信息区域 */
.user-section {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 20rpx;
  padding: 24rpx;
  backdrop-filter: blur(10rpx);
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.username {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 8rpx;
}

.user-stats {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 登录区域 */
.login-section {
  display: flex;
  justify-content: center;
  align-items: center;
}

.login-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.2);
  color: #ffffff;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 50rpx;
  padding: 20rpx 40rpx;
  font-size: 30rpx;
  backdrop-filter: blur(10rpx);
}

.login-btn::after {
  border: none;
}

.login-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
}

/* 功能卡片区域 */
.features-section {
  background: #ffffff;
  border-radius: 40rpx 40rpx 0 0;
  padding: 40rpx;
  margin-top: 20rpx;
  min-height: calc(100vh - 300rpx);
}

.section-title {
  margin-bottom: 40rpx;
}

.title-text {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #1f2937;
  margin-bottom: 8rpx;
}

.title-desc {
  display: block;
  font-size: 28rpx;
  color: #6b7280;
}

.features-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
  margin-bottom: 60rpx;
}

.feature-card {
  position: relative;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  border: 2rpx solid #f1f5f9;
  transition: all 0.3s ease;
}

.feature-card:active {
  transform: translateY(4rpx);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.12);
}

.card-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.card-icon image {
  width: 48rpx;
  height: 48rpx;
}

.text-to-image {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
}

.image-to-image {
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
}

.image-to-25d {
  background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
}

.image-to-3d {
  background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
}

.card-content {
  margin-bottom: 16rpx;
}

.card-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 8rpx;
}

.card-desc {
  display: block;
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.4;
}

.card-badge {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  font-weight: 500;
  color: #ffffff;
}

.card-badge.hot {
  background: #ef4444;
}

.card-badge.new {
  background: #10b981;
}

.card-badge.premium {
  background: #8b5cf6;
}

/* 最近作品区域 */
.recent-section {
  margin-bottom: 60rpx;
}

.recent-section .section-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.more-link {
  font-size: 26rpx;
  color: #6366f1;
}

.works-scroll {
  width: 100%;
  white-space: nowrap;
}

.works-list {
  display: inline-flex;
  padding: 10rpx 0;
}

.work-item {
  display: inline-block;
  width: 200rpx;
  margin-right: 24rpx;
  vertical-align: top;
}

.work-item:last-child {
  margin-right: 0;
}

.work-image {
  width: 100%;
  height: 200rpx;
  border-radius: 16rpx;
  background-color: #f8fafc;
  margin-bottom: 12rpx;
}

.work-info {
  padding: 0 8rpx;
}

.work-title {
  display: block;
  font-size: 24rpx;
  color: #1f2937;
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.work-time {
  display: block;
  font-size: 22rpx;
  color: #9ca3af;
}

/* 空状态 */
.empty-section {
  text-align: center;
  padding: 80rpx 40rpx;
  margin-bottom: 40rpx;
}

.empty-icon {
  width: 160rpx;
  height: 160rpx;
  opacity: 0.6;
  margin-bottom: 32rpx;
}

.empty-text {
  display: block;
  font-size: 32rpx;
  font-weight: 500;
  color: #374151;
  margin-bottom: 12rpx;
}

.empty-desc {
  display: block;
  font-size: 26rpx;
  color: #6b7280;
  margin-bottom: 40rpx;
}

.start-create-btn {
  background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
  color: #ffffff;
  border-radius: 50rpx;
  padding: 24rpx 48rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
}

.start-create-btn::after {
  border: none;
}

/* 底部统计区域 */
.footer-section {
  background: rgba(255, 255, 255, 0.8);
  border-radius: 24rpx;
  padding: 32rpx;
  backdrop-filter: blur(10rpx);
}

.stats-grid {
  display: flex;
  justify-content: space-around;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.stat-number {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #1f2937;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #6b7280;
}

/* 加载状态 */
.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.loading-content {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.loading-icon {
  width: 60rpx;
  height: 60rpx;
  margin-bottom: 24rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #6b7280;
}

/* 响应式适配 */
@media screen and (max-width: 750rpx) {
  .features-grid {
    grid-template-columns: 1fr;
  }
  
  .feature-card {
    display: flex;
    align-items: center;
    padding: 24rpx;
  }
  
  .card-icon {
    width: 60rpx;
    height: 60rpx;
    margin-right: 20rpx;
    margin-bottom: 0;
  }
  
  .card-content {
    flex: 1;
    margin-bottom: 0;
  }
}