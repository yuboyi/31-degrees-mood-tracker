/* pages/profile/index.wxss */

.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
  padding-bottom: 120rpx; /* 为tabBar留出空间 */
}

/* 用户信息区域 */
.user-section {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 60rpx 40rpx 40rpx;
  color: #ffffff;
}

.user-header {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-right: 32rpx;
  border: 6rpx solid rgba(255, 255, 255, 0.3);
}

.user-info {
  flex: 1;
}

.user-name {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
  color: #ffffff;
}

.vip-status {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.vip-badge {
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  margin-right: 16rpx;
  margin-bottom: 8rpx;
}

.vip-badge.normal {
  background: rgba(255, 255, 255, 0.2);
}

.vip-badge.vip {
  background: linear-gradient(135deg, #ffd700 0%, #ffed4e 100%);
  color: #1f2937;
}

.vip-badge.premium {
  background: linear-gradient(135deg, #ff6b6b 0%, #ff8e8e 100%);
}

.vip-text {
  font-size: 24rpx;
  font-weight: 600;
}

.vip-expire {
  font-size: 22rpx;
  opacity: 0.8;
}

.settings-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  backdrop-filter: blur(10rpx);
}

.settings-icon {
  width: 40rpx;
  height: 40rpx;
}

/* 用户统计 */
.user-stats {
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 24rpx;
  padding: 32rpx;
  backdrop-filter: blur(10rpx);
}

.stat-item {
  text-align: center;
}

.stat-number {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
  color: #ffffff;
}

.stat-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.stat-divider {
  width: 2rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.3);
}

/* 未登录状态 */
.login-section {
  text-align: center;
  padding: 100rpx 40rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #ffffff;
}

.login-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  opacity: 0.6;
  margin-bottom: 40rpx;
}

.login-prompt {
  display: block;
  font-size: 32rpx;
  margin-bottom: 60rpx;
  opacity: 0.9;
}

.login-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.2);
  color: #ffffff;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 50rpx;
  padding: 24rpx 48rpx;
  font-size: 32rpx;
  backdrop-filter: blur(10rpx);
}

.login-btn::after {
  border: none;
}

.wechat-icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: 16rpx;
}

/* 功能菜单 */
.menu-section {
  padding: 40rpx;
}

.menu-group {
  background: #ffffff;
  border-radius: 24rpx;
  margin-bottom: 30rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
}

.group-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #6b7280;
  padding: 30rpx 32rpx 20rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  border-bottom: 2rpx solid #f8fafc;
  transition: background-color 0.3s ease;
  position: relative;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background-color: #f8fafc;
}

.menu-item.premium {
  background: linear-gradient(135deg, #fef7ff 0%, #f3e8ff 100%);
}

.menu-icon-wrapper {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f8fafc;
  border-radius: 20rpx;
  margin-right: 24rpx;
}

.menu-icon-wrapper.premium {
  background: linear-gradient(135deg, #8b5cf6 0%, #a855f7 100%);
}

.menu-icon {
  width: 48rpx;
  height: 48rpx;
}

.menu-content {
  flex: 1;
}

.menu-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 8rpx;
}

.menu-desc {
  font-size: 26rpx;
  color: #6b7280;
  line-height: 1.4;
}

.menu-count {
  font-size: 28rpx;
  color: #6366f1;
  font-weight: 600;
  margin-right: 16rpx;
}

.menu-badge {
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
  margin-right: 16rpx;
  font-size: 22rpx;
  font-weight: 500;
  color: #ffffff;
}

.menu-badge:not(.processing) {
  background: #ef4444;
}

.menu-badge.processing {
  background: #f59e0b;
}

.badge-text {
  color: #ffffff;
}

.menu-arrow {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.4;
}

/* 推广分享 */
.share-section {
  padding: 0 40rpx 40rpx;
}

.share-card {
  background: linear-gradient(135deg, #10b981 0%, #34d399 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.share-header {
  display: flex;
  align-items: center;
  flex: 1;
}

.share-icon {
  width: 80rpx;
  height: 80rpx;
  margin-right: 24rpx;
}

.share-content {
  flex: 1;
}

.share-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 8rpx;
}

.share-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  line-height: 1.4;
}

.share-btn {
  background: rgba(255, 255, 255, 0.2);
  color: #ffffff;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 50rpx;
  padding: 20rpx 32rpx;
  font-size: 28rpx;
  font-weight: 500;
  backdrop-filter: blur(10rpx);
}

.share-btn::after {
  border: none;
}

/* 退出登录 */
.logout-section {
  padding: 0 40rpx 40rpx;
}

.logout-btn {
  width: 100%;
  background: #ffffff;
  color: #ef4444;
  border: 2rpx solid #fecaca;
  border-radius: 20rpx;
  padding: 32rpx;
  font-size: 32rpx;
  font-weight: 500;
}

.logout-btn::after {
  border: none;
}

.logout-btn:active {
  background: #fef2f2;
}

/* 加载状态 */
.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.loading-content {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.loading-icon {
  width: 60rpx;
  height: 60rpx;
  margin-bottom: 24rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #6b7280;
}

.spin {
  animation: spin 1s linear infinite;
}

@keyframes spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}