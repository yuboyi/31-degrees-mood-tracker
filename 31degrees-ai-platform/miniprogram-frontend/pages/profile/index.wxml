<!--pages/profile/index.wxml-->
<view class="container">
  <!-- 用户信息区域 -->
  <view class="user-section" wx:if="{{userInfo}}">
    <view class="user-header">
      <image class="user-avatar" src="{{userInfo.avatarUrl || '/images/default-avatar.png'}}" bind:tap="changeAvatar" />
      <view class="user-info">
        <text class="user-name">{{userInfo.nickname || '用户'}}</text>
        <view class="vip-status">
          <view class="vip-badge {{userInfo.vipLevel.toLowerCase()}}">
            <text class="vip-text">{{vipLevelText}}</text>
          </view>
          <text class="vip-expire" wx:if="{{userInfo.vipExpireTime}}">到期：{{vipExpireText}}</text>
        </view>
      </view>
      <view class="settings-btn" bind:tap="navigateToSettings">
        <image class="settings-icon" src="/images/settings-icon.png" />
      </view>
    </view>
    
    <!-- 用户统计 -->
    <view class="user-stats">
      <view class="stat-item" bind:tap="navigateToGallery">
        <text class="stat-number">{{userStats.totalWorks || 0}}</text>
        <text class="stat-label">我的作品</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-number">{{userStats.todayRequests || 0}}/{{userStats.dailyLimit || 10}}</text>
        <text class="stat-label">今日使用</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-number">{{userStats.totalRequests || 0}}</text>
        <text class="stat-label">总请求数</text>
      </view>
    </view>
  </view>

  <!-- 未登录状态 -->
  <view class="login-section" wx:else>
    <image class="login-avatar" src="/images/default-avatar.png" />
    <text class="login-prompt">登录后查看个人信息</text>
    <button class="login-btn" bind:tap="handleLogin">
      <image class="wechat-icon" src="/images/wechat-icon.png" />
      <text>微信登录</text>
    </button>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-section">
    <!-- VIP会员 -->
    <view class="menu-group">
      <view class="menu-item premium" bind:tap="navigateToVip">
        <view class="menu-icon-wrapper premium">
          <image class="menu-icon" src="/images/vip-icon.png" />
        </view>
        <view class="menu-content">
          <text class="menu-title">VIP会员</text>
          <text class="menu-desc">解锁更多功能，享受专属权益</text>
        </view>
        <view class="menu-badge" wx:if="{{userInfo && userInfo.vipLevel === 'NORMAL'}}">
          <text class="badge-text">升级</text>
        </view>
        <image class="menu-arrow" src="/images/arrow-right.png" />
      </view>
    </view>

    <!-- 我的功能 -->
    <view class="menu-group">
      <text class="group-title">我的功能</text>
      
      <view class="menu-item" bind:tap="navigateToGallery">
        <view class="menu-icon-wrapper">
          <image class="menu-icon" src="/images/gallery-icon.png" />
        </view>
        <view class="menu-content">
          <text class="menu-title">我的作品</text>
          <text class="menu-desc">查看和管理所有AI创作</text>
        </view>
        <text class="menu-count">{{userStats.totalWorks || 0}}</text>
        <image class="menu-arrow" src="/images/arrow-right.png" />
      </view>

      <view class="menu-item" bind:tap="navigateToTasks">
        <view class="menu-icon-wrapper">
          <image class="menu-icon" src="/images/tasks-icon.png" />
        </view>
        <view class="menu-content">
          <text class="menu-title">创作任务</text>
          <text class="menu-desc">查看任务进度和历史记录</text>
        </view>
        <view class="menu-badge processing" wx:if="{{processingTasks > 0}}">
          <text class="badge-text">{{processingTasks}}</text>
        </view>
        <image class="menu-arrow" src="/images/arrow-right.png" />
      </view>

      <view class="menu-item" bind:tap="navigateToDownloads">
        <view class="menu-icon-wrapper">
          <image class="menu-icon" src="/images/download-icon.png" />
        </view>
        <view class="menu-content">
          <text class="menu-title">下载记录</text>
          <text class="menu-desc">管理已下载的作品</text>
        </view>
        <image class="menu-arrow" src="/images/arrow-right.png" />
      </view>
    </view>

    <!-- 设置与帮助 -->
    <view class="menu-group">
      <text class="group-title">设置与帮助</text>
      
      <view class="menu-item" bind:tap="navigateToSettings">
        <view class="menu-icon-wrapper">
          <image class="menu-icon" src="/images/settings-icon.png" />
        </view>
        <view class="menu-content">
          <text class="menu-title">设置</text>
          <text class="menu-desc">个人偏好和隐私设置</text>
        </view>
        <image class="menu-arrow" src="/images/arrow-right.png" />
      </view>

      <view class="menu-item" bind:tap="navigateToHelp">
        <view class="menu-icon-wrapper">
          <image class="menu-icon" src="/images/help-icon.png" />
        </view>
        <view class="menu-content">
          <text class="menu-title">帮助与反馈</text>
          <text class="menu-desc">使用教程和问题反馈</text>
        </view>
        <image class="menu-arrow" src="/images/arrow-right.png" />
      </view>

      <view class="menu-item" bind:tap="navigateToAbout">
        <view class="menu-icon-wrapper">
          <image class="menu-icon" src="/images/about-icon.png" />
        </view>
        <view class="menu-content">
          <text class="menu-title">关于我们</text>
          <text class="menu-desc">了解31度文创精灵</text>
        </view>
        <image class="menu-arrow" src="/images/arrow-right.png" />
      </view>
    </view>
  </view>

  <!-- 推广分享 -->
  <view class="share-section" wx:if="{{userInfo}}">
    <view class="share-card">
      <view class="share-header">
        <image class="share-icon" src="/images/share-gift-icon.png" />
        <view class="share-content">
          <text class="share-title">邀请好友</text>
          <text class="share-desc">分享给好友，双方都能获得免费使用次数</text>
        </view>
      </view>
      <button class="share-btn" open-type="share">
        <text>立即分享</text>
      </button>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="logout-section" wx:if="{{userInfo}}">
    <button class="logout-btn" bind:tap="handleLogout">退出登录</button>
  </view>
</view>

<!-- 加载状态 -->
<view class="loading-overlay" wx:if="{{loading}}">
  <view class="loading-content">
    <image class="loading-icon spin" src="/images/loading.png" />
    <text class="loading-text">加载中...</text>
  </view>
</view>